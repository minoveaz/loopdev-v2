{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-run.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "run_id", "status", "legacy_schema_reason"],
      "properties": {
        "schema_version": { "const": 0 },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "running", "completed", "blocked", "failed", "deviated", "waiting_user", "paused"] },
        "legacy_schema_reason": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "workflow_version", "run_id", "suite", "module", "status", "current_phase", "attempt", "environment", "platform_scope", "approvals", "fingerprints", "checkpoint_paths", "invalidated_phases", "next_action"],
      "properties": {
        "schema_version": { "const": 1 },
        "workflow_version": { "type": "integer", "minimum": 1 },
        "run_id": { "type": "string", "pattern": "^MOD-[A-Z0-9-]+-[0-9]{8}-[0-9]{3}$" },
        "suite": { "type": "string" },
        "module": { "type": "string" },
        "profile": { "enum": ["standard", "implementation-first", "supplier-pilot"] },
        "slice_id": { "type": "string", "minLength": 1 },
        "approval_history": { "type": "array", "items": { "type": "object" } },
        "iterations": { "type": "array", "items": { "type": "object" } },
        "status": { "enum": ["pending", "running", "completed", "blocked", "failed", "deviated", "waiting_user", "paused"] },
        "current_phase": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "platform_scope": { "type": "array", "items": { "enum": ["desktop_web", "mobile_web", "ios", "android"] }, "uniqueItems": true },
        "approvals": { "type": "object", "additionalProperties": { "$ref": "delivery-approval.schema.json" } },
        "fingerprints": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } },
        "checkpoint_paths": { "type": "array", "items": { "type": "string" } },
        "invalidated_phases": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "object" },
        "next_action": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["profile"], "properties": { "profile": { "const": "supplier-pilot" } } },
          "then": {
            "required": ["slice_id", "approval_history", "iterations"],
            "properties": { "suite": { "const": "erp" }, "module": { "type": "string", "pattern": "^[Pp]roveedores$" } }
          }
        }
      ]
    }
  ]
}