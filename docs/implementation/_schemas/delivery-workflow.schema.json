{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-workflow.schema.json",
  "type": "object",
  "required": ["schema_version", "initial_phase", "terminal_phase", "phases", "gates", "required_workspace_files", "required_schema_v1_files", "fingerprint_invalidation"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "initial_phase": { "type": "string" },
    "terminal_phase": { "type": "string" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "predecessors", "required_gate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z-]+$" },
          "skill": { "type": "string" },
          "predecessors": { "type": "array", "items": { "type": "string" } },
          "required_gate": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "gates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_workspace_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "required_schema_v1_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "fingerprint_invalidation": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
  }
}