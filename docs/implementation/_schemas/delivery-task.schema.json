{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-task.schema.json",
  "type": "object",
  "required": ["id", "phase", "type", "status", "title", "requirement_ids", "capability_ids", "platforms", "dependencies", "owner", "risk", "evidence_level", "acceptance_criteria", "validation", "files", "blocked_by", "evidence_refs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "phase": { "const": "07-build" },
    "type": { "enum": ["shared_contract", "desktop_renderer", "mobile_renderer", "backend", "migration", "test", "audit"] },
    "status": { "enum": ["pending", "ready", "in_progress", "done", "blocked"] },
    "title": { "type": "string", "minLength": 1 },
    "requirement_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "capability_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "operation_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "platforms": { "type": "array", "items": { "enum": ["shared", "desktop_web", "mobile_web", "ios", "android"] }, "minItems": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "owner": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at", "approval_source"],
      "properties": {
        "approved_by": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "approval_source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "evidence_level": { "enum": ["E0_PRESENT", "E1_LINT", "E2_UNIT", "E3_COMPONENT", "E4_JOURNEY", "E5_DEVICE"] },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "required"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "blocked_by": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}