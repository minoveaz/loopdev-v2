{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["../../src/*"],
      "@contracts/*": ["../../packages/contracts/src/*"],
      "@mobile/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/contracts/src/**/*.ts"
  ]
}
